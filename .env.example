# 브라우저에서 접근 가능한 Spring Boot API 주소. 비밀키를 넣지 마세요.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# FE-03 화면 확인용 경로. 실제 배포에서는 비워두거나 false로 유지합니다.
CUSTOMER_PREVIEW_ENABLED=false
# 화면 검수에서 실제 SMS 대신 예시 로그인을 쓸 때만 true.
OWNER_AUTH_PREVIEW_ENABLED=false

# 업체 설정 화면 검수에만 사용. 운영 환경에는 설정하지 않는다.
OWNER_SETTINGS_PREVIEW_ENABLED=false
