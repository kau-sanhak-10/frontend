# 브라우저에서 접근 가능한 Spring Boot API 주소. 비밀키를 넣지 마세요.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# FE-03 화면 확인용 경로. 실제 배포에서는 비워두거나 false로 유지합니다.
CUSTOMER_PREVIEW_ENABLED=false
# BE-05가 배포되고 실제 동의 문구를 확인한 환경에서만 켭니다.
CUSTOMER_LIVE_ENABLED=false
# 로컬·Dev 시연용 테스트 업체의 링크 토큰만 서버 설정에 넣습니다. 비워두면 시연 주소가 나오지 않습니다.
CUSTOMER_VISIT_DEMO_LINK_TOKEN=
# Enable real photo uploads only on the configured Dev demo link.
CUSTOMER_PHOTO_DEMO_ENABLED=false

# 화면 검수에서 실제 SMS 대신 예시 로그인을 쓸 때만 true.
OWNER_AUTH_PREVIEW_ENABLED=false

# 업체 설정 화면 검수에만 사용. 운영 환경에는 설정하지 않는다.
OWNER_SETTINGS_PREVIEW_ENABLED=false
